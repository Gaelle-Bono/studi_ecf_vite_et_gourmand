{% extends 'base.html.twig' %}

{% block title %}Enregistrement{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Enregistrez-vous</h1>
    {{ form_start(registrationForm, { attr: { 
        novalidate: 'novalidate',
        'data-turbo': 'false',
        'data-controller': 'prevent-double-click',
        'data-action': 'submit->prevent-double-click#disable'
    } })  }}
        {{ form_errors(registrationForm) }}
        {{ form_row(registrationForm.firstName) }}
        {{ form_row(registrationForm.lastName) }}
        {{ form_row(registrationForm.phoneNumber) }}
        {{ form_row(registrationForm.address) }}
        {{ form_row(registrationForm.addressComplement) }}
        {{ form_row(registrationForm.zipCode) }}
        {{ form_row(registrationForm.city) }}
        {{ form_row(registrationForm.email) }}

        <div data-controller="password-visibility">
            {{ form_label(registrationForm.plainPassword.first) }}
            <div class="input-group">
                {{ form_widget(registrationForm.plainPassword.first) }}
                <button
                    type="button"
                    class="btn btn-light"
                    data-action="click->password-visibility#toggle"
                    aria-label="Afficher le mot de passe"
                >
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div data-controller="password-visibility">
            {{ form_label(registrationForm.plainPassword.second) }}
            <div class="input-group">
                {{ form_widget(registrationForm.plainPassword.second) }}
                <button
                    type="button"
                    class="btn btn-light"
                    data-action="click->password-visibility#toggle"
                    aria-label="Afficher le mot de passe"
                >
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        <a
            href="{{ path('app_login') }}"
            class="btn btn-secondary mt-3 me-2"
        >
            <i class="bi bi-x-circle me-2"></i>
            Annuler
        </a>

        <button type="submit" class="btn btn-primary mt-3">
            <i class="bi bi-person-plus me-2"></i>
            S'inscrire
        </button>
        
    {{ form_end(registrationForm) }}
{% endblock %}