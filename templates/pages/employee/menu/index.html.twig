{% extends 'base.html.twig' %}

{% block title %}Gestion des menus{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Gestion des menus</h1>

    {% for menu in menus %}
        <div>
            <h2>{{ menu.title }}</h2>

            <p>
                Statut :
                {% if menu.isActive %}
                    Actif
                {% else %}
                    Inactif
                {% endif %}
            </p>

            <div class="d-flex gap-2">
                <form method="post" action="{{ path('app_employee_menu_toggle_active', {id: menu.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-menu-' ~ menu.id) }}">

                    <button type="submit" class="btn btn-secondary">
                        {% if menu.isActive %}
                            <i class="bi bi-toggle-off me-2"></i>
                            Désactiver
                        {% else %}
                            <i class="bi bi-toggle-on me-2"></i>
                            Réactiver
                        {% endif %}
                    </button>
                </form>

                <a href="{{ path('app_employee_menu_show', {id: menu.id}) }}" class="btn btn-primary">
                    <i class="bi bi-eye me-2"></i>
                    Détails du menu</menu>
                </a>

            </div>
        </div>

        {% if not loop.last %}
            <hr class="my-4">
        {% endif %}
    {% else %}
        <p>Aucun menu enregistré</p>
    {% endfor %}

    <hr class="my-4">

    <a href="{{ path('app_management_index') }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Retour à l'espace de gestion
    </a>
{% endblock %}

