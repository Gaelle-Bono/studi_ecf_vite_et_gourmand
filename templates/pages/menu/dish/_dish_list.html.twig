{% set menuDishes = {
    'Entrée': starter,
    'Plat principal': mainCourse,
    'Dessert': dessert
} %}

{% for label, dish in menuDishes %}
    {% if dish %}
        <p>
            <strong>{{ label }} :</strong> 
            {{ dish.title }}
            {% if dish.allergens is not empty %}
                (allergène{{ dish.allergens|length > 1 ? 's' : '' }} :
                {{ dish.getAllergensAsString }})
            {% endif %}
        </p>
    {% endif %}
{% endfor %}