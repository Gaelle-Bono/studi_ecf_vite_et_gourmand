
{# Starter #}
{% if starter %}
    <p>
        <strong>Entrée :</strong>

        {% if order %}
            {{ starter }}

            {% if starterAllergens %}
                (allergène{{ starterAllergens|split(',')|length > 1 ? 's' : '' }} : {{ starterAllergens }})
            {% endif %}
        {% else %}
            {{ starter.title }}

            {% if starter.allergens is not empty %}
                (allergène{{ starter.allergens|length > 1 ? 's' : '' }} : {{ starter.getAllergensAsString }})
            {% endif %}
        {% endif %}
    </p>
{% endif %}

