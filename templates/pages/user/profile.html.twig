{% extends 'base.html.twig' %}

{% block title %}Mes informations personnelles{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Mes informations personnelles</h1>

    <p><strong>Prénom :</strong> {{ user.firstName }}</p>
    <p><strong>Nom :</strong> {{ user.lastName }}</p>
    <p><strong>Téléphone :</strong> {{ user.phoneNumber }}</p>
    <p><strong>Adresse :</strong> {{ user.address }}</p>

    {% if user.addressComplement %}
        <p><strong>Complément d'adresse :</strong> {{ user.addressComplement }}</p>
    {% endif %}

    <p><strong>Code postal :</strong> {{ user.zipCode }}</p>
    <p><strong>Ville :</strong> {{ user.city }}</p>

    <hr>

    <a href="{{ path('app_change_password') }}" class="btn btn-secondary mt-3">
        <i class="bi bi-key me-2"></i>
        Changer mon mot de passe
    </a>

    <a href="{{ path('app_user_profile_edit') }}" class="btn btn-primary mt-3">
        <i class="bi bi-pencil me-2"></i>
        Modifier mes informations
    </a>

{% endblock %}