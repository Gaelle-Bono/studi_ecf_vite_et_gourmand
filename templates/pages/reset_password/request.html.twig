{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Réinitialisez votre mot de passe</h1>

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <div>
            Entrez votre adresse email. Si un compte existe, vous recevrez un lien de réinitialisation.
        </div>

        <a href="{{ path('app_login') }}" class="btn btn-secondary mt-3">Annuler</a>
        
        <button class="btn btn-primary mt-3">Envoyer</button>

    {{ form_end(requestForm) }}
{% endblock %}