{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Détails de ma commande</h1>

    <h3>Commande</h3>

    <strong>Numéro :</strong> {{ order.orderNumber }}<br>
    <strong>Date de commande :</strong> {{ order.createdAt|date('d/m/Y à H:i') }}<br>

    {% if order.updatedAt %}
        <strong>Dernière modification :</strong> {{ order.updatedAt|date('d/m/Y à H:i') }}
    {% endif %}

    {% include 'pages/order/_status.html.twig' %}

    {% if canEdit %}
        <div class="d-flex gap-2 mt-3">
            <form method="post"
                action="{{ path('app_order_cancel', {id: order.id}) }}"
                onsubmit="return confirm('Confirmez-vous l’annulation de cette commande ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">

                <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-2"></i>
                    Annuler la commande
                </button>
            </form>
            
            <a href="{{ path('app_order_edit', {id: order.id}) }}"
            class="btn btn-primary">
            <i class="bi bi-pencil me-2"></i>
                Modifier la commande
            </a>

        </div>
    {% endif %}

    {# Status history #}
    {% if statusHistory|length > 1 %}
        {% include 'pages/order/_status_history.html.twig' with {
            statusHistory: statusHistory
        } %}
    {% endif %}
    
    {# Customer #}
    {% include 'pages/order/_customer.html.twig' with {
        firstName: order.customerFirstNameAtOrder,
        lastName: order.customerLastNameAtOrder,
        email: order.customerEmailAtOrder,
        phone: order.customerPhoneAtOrder
    } %}

    {# Service Details #}
    {% include 'pages/order/_service_details.html.twig' with {
        street: order.serviceAddress,
        complement: order.serviceAddressComplement,
        zip: order.serviceZipCode,
        city: order.serviceCity,
        deliveryInstructions: order.deliveryInstructionsAtOrder,
        serviceDate: order.requestedDeliveryAt,
        requestedTime: order.requestedDeliveryAt|date('H:i')
    } %}

    {# Order details #}
    {% embed 'pages/order/_order_menu_details.html.twig' with {
        menuTitle: order.menuTitleAtOrder,
        menuDescription: order.menuDescriptionAtOrder,
        includedEquipmentDescription: order.includedEquipmentDescriptionAtOrder,
        numberOfPeople: order.numberOfPeople
    } %}
        {% block dishes %}
            {% include 'pages/order/_dish_list_at_order.html.twig' with {
                starter: order.starterTitleAtOrder,
                mainCourse: order.mainCourseTitleAtOrder,
                dessert: order.dessertTitleAtOrder,
                starterAllergens: order.starterAllergensAtOrder,
                mainCourseAllergens: order.mainCourseAllergensAtOrder,
                dessertAllergens: order.dessertAllergensAtOrder
            } %}
        {% endblock %}
    {% endembed %}

    {# Prices #}
    {% set discountAmount = order.servicePriceBeforeDiscountAtOrder - order.servicePriceAtOrder %}

    {% include 'pages/order/_prices_details.html.twig' with {
        servicePriceBeforeDiscount: order.servicePriceBeforeDiscountAtOrder,
        servicePrice: order.servicePriceAtOrder,
        deliveryPrice: order.deliveryPriceAtOrder,
        totalPrice: order.totalPriceAtOrder,
        hasDiscount: discountAmount > 0,
        discountAmount: discountAmount,
        groupDiscountPercent: ((discountAmount / order.servicePriceBeforeDiscountAtOrder) * 100)|round
    } %}


    {% if order.orderStatus == constant('App\\Enum\\OrderStatus::COMPLETED') %}
        {% if order.review %}
            <h3 class="mt-4">Votre avis</h3>
            
            <p>
                {% for i in 1..5 %}
                    {% if i <= order.review.rating %}
                        <i class="bi bi-star-fill"></i>
                    {% else %}
                        <i class="bi bi-star"></i>
                    {% endif %}
                {% endfor %}
            </p>

            <p>{{ order.review.comment }}</p>
        {% else %}
            <a href="{{ path('app_review_new', {id: order.id}) }}"
                class="btn btn-primary mt-3">
                <i class="bi bi-star me-2"></i>
                Donner mon avis
            </a>
        {% endif %}

    {% endif %}

    <a href="{{ path('app_order_my_orders') }}"
        class="btn btn-secondary mt-3"
    ><i class="bi bi-receipt me-2"></i>
        Mes commandes
    </a>

{% endblock %}