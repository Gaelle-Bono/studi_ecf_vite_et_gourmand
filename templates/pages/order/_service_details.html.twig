<h3>Prestation</h3>

<p>
    <strong>Adresse :</strong><br>
    {{ street }}<br>
    {% if complement %}
        {{ complement }}<br>
    {% endif %}
    {{ zip }} {{ city }}
</p>

    {% if deliveryInstructions %}
        <p>
            <strong>Instructions de livraison :</strong> {{ deliveryInstructions }}
        </p>
    {% endif %}

<p>
    <strong>Date souhaitée de la prestation :</strong> {{ serviceDate|date('d/m/Y') }} à {{ requestedTime }}
</p>