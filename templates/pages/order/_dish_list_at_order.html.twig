
{% set menuDishes = {
    'Entrée': {
        title: starter,
        allergens: starterAllergens
    },
    'Plat principal': {
        title: mainCourse,
        allergens: mainCourseAllergens
    },
    'Dessert': {
        title: dessert,
        allergens: dessertAllergens
    }
} %}

{% for label, dish in menuDishes %}
    {% if dish.title %}
        <p>
            <strong>{{ label }} :</strong>
            {{ dish.title }}
            {% if dish.allergens %}
                (allergène{{ dish.allergens|split(', ')|length > 1 ? 's' : '' }} :
                {{ dish.allergens }})
            {% endif %}
        </p>
    {% endif %}
{% endfor %}
