<div data-order-form-target="step4" class="hidden">
    <h2>Récapitulatif de la commande</h2>

    <div data-order-form-target="summary"></div>

    <button 
        type="button" 
        data-order-form-target="previousButtonStep4" 
        data-action="click->order-form#returnToStep3" 
        class="btn btn-secondary mt-3" 
    >
        <i class="bi bi-arrow-left me-2"></i>
        <span data-order-form-target="previousButtonStep4Label">Retour</span>
    </button>

    <button
        type="submit"
        data-order-form-target="submitButton"
        class="btn btn-primary mt-3"
    >
        {% if edit %}
            <i class="bi bi-pencil me-2"></i>
            Modifier la commande
        {% else %}
            <i class="bi bi-cart4 me-2"></i>
            Commander
        {% endif %}
    </button>

</div>