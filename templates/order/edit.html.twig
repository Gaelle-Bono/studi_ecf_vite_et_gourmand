{% extends 'base.html.twig' %}


{% block title %}Modifier une commande{% endblock %}

{% block body %}
    <h1>Modifier une commande</h1>
    {{ form_start(form, { attr: { 
        novalidate: 'novalidate',
        'data-controller': 'order-form',
        'data-times-url' : path('app_order_available_times'),
        'data-edit': 'true',
        'data-order-id': order.id,
        'data-validate-number-of-people-url': path('app_order_validate_number_of_people'),
        'data-summary-url': path('app_order_summary'),
        'data-action': 'submit->order-form#onSubmit keydown->order-form#handleKeydown',
        'data-turbo': 'false' 
    } })  }}    

    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div>
                <strong>Impossible de traiter votre demande</strong><br>
                {{ form_errors(form) }}
            </div>
        </div>
    {% endif %}


    {# stepper #}
    {% include 'order/_form/_stepper.html.twig' %}

    {# step 1: customer info and service details #}
    {% include 'order/_form/_step1_customer_service.html.twig' %}

    {# step 2: menu page #}
    {% include 'order/_form/_step2_menu.html.twig' with {
        edit: true,
        menu: order.menu
    } %}

    {# step 3: number of people #}
    {% include 'order/_form/_step3_people.html.twig' %}

    {# step 4: order summary and confirmation #}
    {% include 'order/_form/_step4_summary.html.twig' with {
        edit: true
    } %}
    
    {{ form_row(form._token) }}
        
    {{ form_end(form, {'render_rest': false}) }}

{% endblock %}

