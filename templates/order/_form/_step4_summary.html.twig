<div data-order-form-target="step4" class="hidden">
    <h2>Récapitulatif de la commande</h2>

    <div data-order-form-target="summary"></div>

    <button
        type="button"
        data-order-form-target="previousButtonStep4"
        data-action="click->order-form#returnToStep3"
    >
        Retour
    </button>

    <button
        type="submit"
        data-order-form-target="submitButton"
        class="btn btn-primary"
    >
        {{ edit ? 'Modifier la commande' : 'Commander' }}
    </button>
</div>