<div class="order-summary">

    {# Customer #}
    {% include 'order/_customer.html.twig' with {
        firstName: customer.firstName,
        lastName: customer.lastName,
        email: customer.email,
        phone: customer.phone
    } %}


    {# Service details #}
    {% include 'order/_service_details.html.twig' with {
        street: serviceAddress.street,
        complement: serviceAddress.complement,
        zip: serviceAddress.zip,
        city: serviceAddress.city,
        deliveryInstructions: deliveryInstructions,
        serviceDate: serviceDate,
        requestedTime: requestedTime
    } %}


    {# Order details #}
    {% embed 'order/_order_menu_details.html.twig' with {
        menuTitle: menu.title,
        menuDescription: menu.description,
        includedEquipmentDescription: menu.includedEquipmentDescription,
        numberOfPeople: numberOfPeople
    } %}
        {% block dishes %}
            {% include 'menu/dish/_dish_list.html.twig' with {
                starter: menu.starter,
                mainCourse: menu.mainCourse,
                dessert: menu.dessert
            } %}
        {% endblock %}
    {% endembed %}


    {# Prices #}
    {% include 'order/_prices_details.html.twig' with {
        servicePriceBeforeDiscount: pricing.servicePriceBeforeDiscount,
        servicePrice: pricing.servicePrice,
        deliveryPrice: pricing.deliveryPrice,
        totalPrice: pricing.totalPrice,
        hasDiscount: pricing.hasDiscount,
        discountAmount: pricing.discountAmount,
        groupDiscountPercent: groupDiscountPercent
    } %}


</div>