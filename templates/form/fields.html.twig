{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="invalid-feedback d-block">
            {% for error in errors %}
                <div>{{ error.message }}</div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}


{% block form_widget %}
    {% set type = type|default('text') %}
    {% set base_class = '' %}
    {% if type in ['text', 'email', 'password', 'number', 'date', 'time'] %}
        {% set base_class = 'form-control' %}
    {% elseif type == 'textarea' %}
        {% set base_class = 'form-control' %}
    {% elseif type == 'choice' %}
        {% set base_class = 'form-select' %}
    {% endif %}
    {% set attr = attr|merge({
        class: (attr.class|default('')) ~
            (errors|length ? ' is-invalid' : '') ~
            ' ' ~ base_class
    }) %}
    {{ block('form_widget_simple') }}
{% endblock %}


{% block form_help %}
    {% if help is not empty %}
        <div class="form-text">
            {{ help }}
        </div>
    {% endif %}
{% endblock %}