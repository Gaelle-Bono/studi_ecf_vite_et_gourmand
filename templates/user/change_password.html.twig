{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}

    <h1 class="h3 mb-3">Changer mon mot de passe</h1>

    {{ form_start(changePasswordForm, {
        attr: {
            novalidate: 'novalidate',
            'data-turbo': 'false'
        }
    }) }}

        <div data-controller="password-visibility">
            {{ form_label(changePasswordForm.currentPassword) }}
            <div class="input-group">
                {{ form_widget(changePasswordForm.currentPassword) }}
                <button
                    type="button"
                    class="btn btn-light"
                    data-action="click->password-visibility#toggle"
                    aria-label="Afficher le mot de passe"
                >
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            {{ form_errors(changePasswordForm.currentPassword) }}
        </div>


        <div data-controller="password-visibility">
            {{ form_label(changePasswordForm.plainPassword.first) }}
            <div class="input-group">
                {{ form_widget(changePasswordForm.plainPassword.first) }}
                <button
                    type="button"
                    class="btn btn-light"
                    data-action="click->password-visibility#toggle"
                    aria-label="Afficher le mot de passe"
                >
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            {{ form_errors(changePasswordForm.plainPassword.first) }}
        </div>

        <div data-controller="password-visibility">
            {{ form_label(changePasswordForm.plainPassword.second) }}
            <div class="input-group">
                {{ form_widget(changePasswordForm.plainPassword.second) }}
                <button
                    type="button"
                    class="btn btn-light"
                    data-action="click->password-visibility#toggle"
                    aria-label="Afficher le mot de passe"
                >
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            {{ form_errors(changePasswordForm.plainPassword.second) }}
        </div>

        <a
            href="{{ path('app_user_profile') }}"
            class="btn btn-secondary mt-3"
        ><i class="bi bi-x-circle me-2"></i>
            Annuler
        </a>

        <button
            type="submit"
            class="btn btn-primary mt-3"
            data-controller="prevent-double-click"
            data-action="click->prevent-double-click#disable"
        > <i class="bi bi-floppy me-2"></i>
            Mettre à jour
        </button>

    {{ form_end(changePasswordForm) }}

    

{% endblock %}