{% extends 'base.html.twig' %}

{% block title %}Mes informations personnelles{% endblock %}

{% block body %}
    <h1 class="h3 mb-3">Mes informations personnelles</h1>

    {{ form_start(profileForm, {
        attr: {
            novalidate: 'novalidate',
            'data-turbo': 'false'
        }
    }) }}

        {{ form_errors(profileForm) }}

        {{ form_row(profileForm.firstName) }}
        {{ form_row(profileForm.lastName) }}
        {{ form_row(profileForm.phoneNumber) }}
        {{ form_row(profileForm.address) }}
        {{ form_row(profileForm.addressComplement) }}
        {{ form_row(profileForm.zipCode) }}
        {{ form_row(profileForm.city) }}

        <a href="{{ path('app_change_password') }}"
            class="btn btn-secondary mt-3"
        ><i class="bi bi-key me-2"></i> 
            Changer mon mot de passe
        </a>

        <button
            type="submit"
            class="btn btn-primary mt-3"
            data-controller="prevent-double-click"
            data-action="click->prevent-double-click#disable"
        >
            <i class="bi bi-floppy me-2"></i>
            Mettre à jour
        </button>

    {{ form_end(profileForm) }}
   

{% endblock %}