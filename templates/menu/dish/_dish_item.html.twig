<li>
    {{ dish.title }}

    {% set count = dish.allergens|length %}

    {% if count > 0 %}
        (Allergène{% if count > 1 %}s{% endif %} :
        {% for allergen in dish.allergens %}
            {{ allergen.name }}
            {% if not loop.last %}
              , 
            {% endif %}
        {% endfor %}
        )
    {% endif %}
</li>