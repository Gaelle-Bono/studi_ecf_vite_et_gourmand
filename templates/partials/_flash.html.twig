{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% if label == 'error' %}
            {% set alertType = 'danger' %}
        {% else %}
            {% set alertType = label %}
        {% endif %}
        <div class="alert alert-{{ alertType }}">
            {{ message|nl2br }}
        </div>
    {% endfor %}
{% endfor %}